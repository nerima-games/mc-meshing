{
  // Shipped source only, check-only. `tsconfig.release.json` is the sole
  // emitting configuration (`pnpm build`); this file exists so `pnpm typecheck`
  // can type-check the shipped surface without leaving generated files in src.
  "extends": "./tsconfig.base.json",
  "include": ["src/index.ts", "src/domain/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
