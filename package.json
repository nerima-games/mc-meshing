{
  "name": "@nerima-games/mc-meshing",
  "version": "0.1.5",
  "type": "module",
  "description": "Pure chunk-data -> geometry-buffer conversion for the nerima-games Minecraft-clone rebuild: the three-valued opacity model, canonical face order, and greedy meshing.",
  "homepage": "https://github.com/nerima-games/mc-meshing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-meshing.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-meshing/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "meshing",
    "greedy-meshing"
  ],
  "scripts": {
    "bench": "tsx scripts/bench-meshing.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
