{
  "name": "@nerima-games/mc-meshing",
  "version": "0.1.4",
  "type": "module",
  "description": "Pure chunk-data -> geometry-buffer conversion for the nerima-games Minecraft-clone rebuild: the three-valued opacity model, canonical face order, and greedy meshing.",
  "homepage": "https://github.com/nerima-games/mc-meshing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-meshing.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-meshing/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "meshing",
    "greedy-meshing"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json --pretty false && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2024 --external:effect --outfile=dist/index.js --sourcemap",
    "lint": "oxlint --deny-warnings src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench-meshing.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  }
}
